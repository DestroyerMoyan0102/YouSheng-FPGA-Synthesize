// DEN=L14; G7=L18. RGB[1:0] are unconnected panel bits; leave their FPGA pins free.
// key_metronome_n=AB22 (J8-10); lcd_g[0]=V20 (J8-12 must stay unconnected).

IO_LOC  "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "touch_scl" AB20;
IO_PORT "touch_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "touch_sdo" AA21;
IO_PORT "touch_sdo" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
